# Process environment overrides this file. Existing ~/.reinhardt/config is
# read first, so the original application's settings remain usable.
LISTEN_ADDR=127.0.0.1:8000
ALLOWED_HOSTS=127.0.0.1,localhost
URL_PREFIX=
ACCESS_URL_PREFIX=
DELEGATE_DOWNLOAD_PREFIX=

# Defaults: BASE_DIR=$user_home/.reinhardt,
# DATABASE_PATH=$BASE_DIR/db.sqlite3, COVERS_DIR=$BASE_DIR/covers.
# Existing Django data and ~/.reinhardt/config are used by default.
# Set DATABASE_PATH explicitly when using a separate database copy.
# BASE_DIR=/srv/reinhardt
# DATABASE_PATH=/srv/reinhardt/db.sqlite3
# COVERS_DIR=/srv/reinhardt/covers
# SECRET_KEY=your-existing-secret-key-to-preserve-shared-playlist-links
LANGUAGE_CODE=en-us
TIME_ZONE=UTC
SANITIZE_TAGS=true
SHARED_PLAYLIST_DOWNLOAD_MAX_SECONDS=10800
MUSIC_IMPORT_DIR=
MAX_UPLOAD_BYTES=536870912
COOKIE_SECURE=false
LOG_LEVEL=30
CSRF_TRUSTED_ORIGINS=

JAMA_ENDPOINT=
JAMA_KEY=
JAMA_PROJECT=
DBX_KEY=
DBX_SECRET=
# DBX_TOKEN is a refresh token, matching the Django application.
DBX_TOKEN=
# Retained for configuration compatibility; the original module has no routes.
DISCOGS_TOKEN=

EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=webmaster@localhost
